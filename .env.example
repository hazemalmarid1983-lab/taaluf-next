# Airtable — قاعدة TaalofDB
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXXXX
AIRTABLE_BASE_NAME=TaalofDB
AIRTABLE_STUDENTS_TABLE=Students
AIRTABLE_SPECIALISTS_TABLE=Specialists
AIRTABLE_ASSESSMENTS_TABLE=Assessments
AIRTABLE_CRITERIA_TABLE=AssessmentCriteria
AIRTABLE_REPORTS_TABLE=Reports
AIRTABLE_SURVEYS_TABLE=ParentSurveys

# OpenAI
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Tap Payments (اختياري حتى يتوفر السجل التجاري)
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_ENVIRONMENT=sandbox

# وضع تجريبي — فتح البوابات بدون دفع
NEXT_PUBLIC_PAYMENTS_DISABLED=true
PAYMENTS_DISABLED=true
TAALUF_PILOT_MODE=true
ALLOW_DEMO_USERS=true

# Vercel (تُعبأ تلقائياً عند النشر)
VERCEL_URL=
