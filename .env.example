# ─── Airtable (TaalofDB) ───────────────────────────────────────────
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXXXX
AIRTABLE_BASE_NAME=TaalofDB
AIRTABLE_STUDENTS_TABLE=Students
AIRTABLE_SPECIALISTS_TABLE=Specialists
AIRTABLE_ASSESSMENTS_TABLE=Assessments
AIRTABLE_CRITERIA_TABLE=AssessmentCriteria
AIRTABLE_REPORTS_TABLE=Reports
AIRTABLE_SURVEYS_TABLE=ParentSurveys
AIRTABLE_CONSENTS_TABLE=Consents
AIRTABLE_AUDIT_TABLE=AuditLog
AIRTABLE_PAYMENTS_TABLE=Payments
AIRTABLE_MESSAGES_TABLE=Messages
AIRTABLE_GAME_SESSIONS_TABLE=GameSessions

# ─── الذكاء الاصطناعي ──────────────────────────────────────────────
# Gemini — التقارير السريرية وتحليل الفيديو (أحدثهما أولوية)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI — توليد الأنشطة والتحليل الاحتياطي
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini

# ─── NextAuth ──────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars

# ─── Tap Payments (اختياري — بدون سجل تجاري يُعطّل الدفع) ─────────
TAP_SECRET_KEY=
TAP_PUBLIC_KEY=
TAP_ENVIRONMENT=sandbox

# ─── وضع تجريبي / Pilot ────────────────────────────────────────────
# true = فتح البوابات بدون دفع حقيقي
NEXT_PUBLIC_PAYMENTS_DISABLED=true
PAYMENTS_DISABLED=true
TAALUF_PILOT_MODE=true
NEXT_PUBLIC_TAALUF_PILOT_MODE=true
# حسابات تجريبية: admin@taaluf.local (حازم) · samer@taaluf.local (د. سامر / المركز البحثي)
# specialist@taaluf.local · parent@taaluf.local — كلمة المرور: taaluf123
ALLOW_DEMO_USERS=true

# ─── RBAC (التطوير فقط — مُعطّل تلقائياً في NODE_ENV=production) ─
# NEXT_PUBLIC_RBAC_DEV=true

# ─── Vercel (تُعبأ تلقائياً عند النشر) ─────────────────────────────
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# ─── Smoke tests (scripts/smoke-paths.mjs) ─────────────────────────
# SMOKE_BASE=http://127.0.0.1:3000

# ─── تخزين hub (غرفة الاجتماعات + MOU) ─────────────────────────────
# محلياً: `.data/` — على Vercel: `/tmp/taaluf-data` (مؤقت؛ ليس للإطلاق الواسع)
# TAALUF_DATA_DIR=/path/to/persistent/storage
